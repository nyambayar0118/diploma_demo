# Caddy HTTPS-ийг хүлээн авч (Let's Encrypt гэрчилгээ, автоматаар шинэчилнэ), бүх хүсэлтийг Nginx нэвтрэх цэг рүү дамжуулна.

{$DOMAIN} {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
	reverse_proxy web:80
}
