# Copy to .env and change the password. .env is never committed.
DB_NAME=routeplanner
DB_USER=routeplanner
DB_PASSWORD=change-me
# Port on your computer where the app opens: http://localhost:8080
HTTP_PORT=8080
# Secret for signing login tokens (at least 32 random characters). Generate one in PowerShell:
#   -join ((48..57)+(65..90)+(97..122) | Get-Random -Count 48 | % {[char]$_})
JWT_SECRET=change-me-to-48-random-characters-0123456789abcdef
