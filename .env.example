# Copy to .env and change the password. .env is never committed.
DB_NAME=routeplanner
DB_USER=routeplanner
DB_PASSWORD=change-me
# Port on your computer where the app opens: http://localhost:8080
HTTP_PORT=8080
# Secret for signing login tokens (at least 32 random characters). Generate one in PowerShell:
#   -join ((48..57)+(65..90)+(97..122) | Get-Random -Count 48 | % {[char]$_})
JWT_SECRET=change-me-to-48-random-characters-0123456789abcdef

# Google login (optional): OAuth client id of type "Web application" from https://console.cloud.google.com
# (APIs & Services -> Credentials). Leave empty to hide the Google button.
GOOGLE_CLIENT_ID=
# Your own e-mail(s), comma-separated: these accounts become ADMIN at their next login
ADMIN_EMAILS=

# Alert e-mails to the administrator (optional). Gmail: SMTP_HOST=smtp.gmail.com, SMTP_USERNAME=your Gmail,
# SMTP_PASSWORD=an app password (Google account -> Security -> App passwords)
ALERT_EMAIL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=

# ---- Production (docs/DEPLOY.md) ----
# Public name of the server; Caddy gets an HTTPS certificate for it automatically
DOMAIN=myplanner.duckdns.org
# Home server only: DuckDNS subdomain (without .duckdns.org) and token from https://www.duckdns.org
DUCKDNS_SUBDOMAIN=myplanner
DUCKDNS_TOKEN=
# Uncomment on a home server so the DuckDNS updater starts too
# COMPOSE_PROFILES=duckdns
BACKUP_KEEP_DAYS=14
