# .env нэрээр хуулж, нууц үгийг солино. .env файлыг хэзээ ч git-д оруулахгүй.
DB_NAME=routeplanner
DB_USER=routeplanner
DB_PASSWORD=change-me
# Апп нээгдэх компьютерийн порт: http://localhost:8080
HTTP_PORT=8080
# Нэвтрэх токенд гарын үсэг зурах нууц түлхүүр (дор хаяж 32 санамсаргүй тэмдэгт). PowerShell-д үүсгэх:
#   -join ((48..57)+(65..90)+(97..122) | Get-Random -Count 48 | % {[char]$_})
JWT_SECRET=change-me-to-48-random-characters-0123456789abcdef

# Google-ээр нэвтрэх (заавал биш): https://console.cloud.google.com-оос "Web application" төрлийн OAuth client id
# (APIs & Services -> Credentials). Хоосон орхивол Google товч харагдахгүй.
GOOGLE_CLIENT_ID=
# Өөрийн имэйл(үүд), таслалаар тусгаарлана: дараагийн нэвтрэлтээс ADMIN болно
ADMIN_EMAILS=

# Администраторт илгээх анхааруулгын имэйл (заавал биш). Gmail: SMTP_HOST=smtp.gmail.com, SMTP_USERNAME=таны Gmail,
# SMTP_PASSWORD=app password (Google account -> Security -> App passwords)
ALERT_EMAIL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=

# ---- Үйлдвэрлэлийн орчин (docs/DEPLOY.md) ----
# Серверийн нийтийн нэр; Caddy түүнд HTTPS гэрчилгээг автоматаар авна
DOMAIN=myplanner.duckdns.org
# Зөвхөн гэрийн серверт: DuckDNS дэд домэйн (.duckdns.org-гүй) болон https://www.duckdns.org-оос авсан токен
DUCKDNS_SUBDOMAIN=myplanner
DUCKDNS_TOKEN=
# Гэрийн серверт DuckDNS шинэчлэгч мөн ажиллахаар доорхын тайлбарыг арилгана
# COMPOSE_PROFILES=duckdns
BACKUP_KEEP_DAYS=14

# Minu Map API-ийн токен (map.minu.mn/developer -> "Token авах"), зөвхөн minu-import хэрэгсэл ашиглана
MINU_API_TOKEN=
